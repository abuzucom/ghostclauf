{
    "name": "ghostclauf",
    "version": "0.7.0",
    "description": "Lightweight, extensible chat bot. First deployment: Twitch.",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "bin": {
        "ghostclauf": "dist/index.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "dev": "tsx watch src/index.ts",
        "auth": "tsx src/tools/authFlow.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint . && prettier --check .",
        "lint:fix": "eslint --fix . && prettier --write .",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@twurple/api": "7.4.0",
        "@twurple/auth": "7.4.0",
        "@twurple/eventsub-ws": "7.4.0",
        "dotenv": "17.4.2",
        "luxon": "3.7.2",
        "pino": "10.3.1",
        "yaml": "2.9.0",
        "zod": "4.4.3"
    },
    "overrides": {
        "brace-expansion": "5.0.9",
        "nanoid": "3.3.18",
        "ws": "8.21.1"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/luxon": "3.7.2",
        "@types/node": "26.1.2",
        "eslint": "10.8.0",
        "eslint-config-prettier": "10.1.8",
        "pino-pretty": "13.1.3",
        "prettier": "3.9.6",
        "tsx": "4.23.9",
        "typescript": "5.9.3",
        "typescript-eslint": "8.65.0",
        "vitest": "3.2.7"
    },
    "license": "MIT"
}
