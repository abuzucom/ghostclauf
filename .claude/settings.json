{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 ${CLAUDE_PROJECT_DIR}/hooks/block_destructive_bash.py",
                        "timeout": 30
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 ${CLAUDE_PROJECT_DIR}/hooks/check_branch_name_session_start.py",
                        "timeout": 30
                    }
                ]
            }
        ]
    }
}
