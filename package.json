{
    "name": "ghostclauf",
    "version": "0.10.0",
    "description": "Lightweight, extensible chat bot. First deployment: Twitch.",
    "type": "module",
    "engines": {
        "node": ">=22.22.0"
    },
    "bin": {
        "ghostclauf": "dist/index.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "dev": "tsx watch src/index.ts",
        "auth": "tsx src/tools/authFlow.ts",
        "export:public": "tsx src/tools/exportPublicSite.ts",
        "lint:site": "html-validate site/**/*.html && stylelint site/**/*.css",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint . && prettier --check .",
        "lint:fix": "eslint --fix . && prettier --write .",
        "format": "prettier --write .",
        "fuzz": "npm run build && node scripts/run-fuzz.js",
        "fuzz:long": "npm run build && node scripts/run-fuzz.js --max-total-time=600"
    },
    "dependencies": {
        "@twurple/api": "8.1.4",
        "@twurple/auth": "8.1.4",
        "@twurple/eventsub-ws": "8.1.4",
        "dotenv": "17.4.2",
        "luxon": "3.7.2",
        "pino": "10.3.1",
        "yaml": "2.9.1",
        "zod": "4.6.5"
    },
    "overrides": {
        "brace-expansion": "5.0.12",
        "fast-copy": "4.1.0",
        "nanoid": "3.3.18",
        "postcss-selector-parser": "7.1.6",
        "source-map-js": "1.2.2",
        "ws": "8.21.1"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@jazzer.js/core": "4.0.0",
        "@types/luxon": "3.7.3",
        "@types/node": "26.6.3",
        "eslint": "10.11.0",
        "eslint-config-prettier": "10.1.8",
        "html-validate": "11.16.0",
        "pino-pretty": "13.1.3",
        "prettier": "3.9.6",
        "stylelint": "17.14.1",
        "stylelint-config-standard": "40.0.0",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.0",
        "vitest": "5.0.3"
    },
    "license": "MIT"
}
